    "@orderly.network/ui": "^3.0.3",
    "@orderly.network/utils": "^3.0.3",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@orderly.network/core": "^3.0.3",
    "@orderly.network/react-app": "^3.0.3",
    "@orderly.network/trading": "^3.0.3",
    "@orderly.network/ui-scaffold": "^3.0.3",
    "@orderly.network/wallet-connector-privy": "^3.0.3",
    "@solana-mobile/wallet-adapter-mobile": "^2.2.6",
