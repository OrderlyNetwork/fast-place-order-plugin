    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "storybook": "^10.3.1",
    "tailwind-variants": "^0.2.1",
    "tailwindcss": "^3.4.19",
